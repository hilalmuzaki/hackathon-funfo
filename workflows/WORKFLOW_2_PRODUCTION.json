      "id": "cc18e1db-80b0-44b7-8436-17734178fabf",
      "name": "MCP Fetch PBV",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -1072,
        960
      ],
      "active": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "YMUN9NfLYMVE12bG",
          "name": "sectors_api"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const b1Data = $('B1 Extract Symbols').first().json;\nconst mostTraded = b1Data.mostTraded || [];\nlet snapshot = [];\ntry { snapshot = $('Get Supabase Snapshot').all().map(i => i.json); } catch(e){ snapshot=[]; }\n\nconst pbvRaw = $('MCP Fetch PBV').all().map(i=>i.json);\nlet pbvFlat=[]; pbvRaw.forEach(r=>{ if(Array.isArray(r.results)) pbvFlat.push(...r.results); else if(Array.isArray(r)) pbvFlat.push(...r); else if(r?.symbol) pbvFlat.push(r); });\nconst pbvMap = Object.fromEntries(pbvFlat.map(i=>[String(i.symbol).replace('.JK',''), Number(i.pb_mrq ?? i.pb ?? i.pbv ?? 1) || 1]));\n\nconst VOLUME_SPIKE = 2.0;\nconst PBV_EXPENSIVE = 4.0;\nconst anomalies=[];\nconst snapshot_data=[];\n\nmostTraded.forEach(stock=>{\n  const symbol=String(stock.symbol).replace('.JK','');\n  const currentVol=Number(stock.volume)||0;\n  const pbv=pbvMap[symbol] ?? 1;\n  const prevData=snapshot.find(s=>String(s.symbol).replace('.JK','')===symbol);\n  const prevVol=prevData?Number(prevData.volume):0;\n  \n  snapshot_data.push({\n    symbol,\n    volume: currentVol,\n    checked_at: new Date().toISOString()\n  });\n  \n  if(prevVol>0){\n    const ratio=currentVol/prevVol;\n    if(ratio>=VOLUME_SPIKE && pbv>=PBV_EXPENSIVE) anomalies.push({symbol,currentVol,prevVol,ratio:ratio.toFixed(2),pbv:String(pbv)});\n  }\n});\n\nreturn { \n  has_anomaly: anomalies.length > 0,\n  anomalies, \n  snapshot_data \n};"
      },
