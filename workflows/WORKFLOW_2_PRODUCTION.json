    {
      "parameters": {
        "jsCode": "const { anomalies } = $('B2 Deteksi Anomali').first().json;\nconst waktu = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB';\n\nlet msg = `🚨 *ANTI-FOMO ALERT* — ${waktu}\\n\\n`;\nmsg += `Terdeteksi lonjakan volume nggak wajar tapi valuasi tergolong mahal:\\n\\n`;\n\nanomalies.forEach(a => {\n  msg += `*${a.symbol}*\\n`;\n  msg += `Volume naik ${a.ratio}x dari checkpoint sebelumnya\\n`;\n  msg += `PBV: ${a.pbv}\\n\\n`;\n});\n\nmsg += `⚠️ *Ini bukan sinyal beli.* Lonjakan volume tanpa dukungan fundamental sering jadi jebakan FOMO. Cek dulu laporan keuangannya sebelum ambil keputusan.`;\n\nreturn [{ json: { telegram_message: msg } }];"
      },
      "id": "c07e75cb-fba0-443b-a9c4-4503b354e62e",
      "name": "B3 Format Telegram FOMO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -384,
        848
      ],
      "active": true
