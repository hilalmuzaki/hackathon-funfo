        "jsCode": "const b2Data = $('B2 Deteksi Anomali').first().json;\nconst snapshot_data = b2Data?.snapshot_data || [];\n\nconst payload = snapshot_data.map(item => ({\n  json: {\n    symbol: String(item.symbol || ''),\n    volume: Number(item.volume) || 0,\n    checked_at: item.checked_at || new Date().toISOString()\n  }\n}));\n\nreturn payload;"
