    {
      "parameters": {
        "jsCode": "const raw = $('MCP Most Traded').first().json;\nconst dates = Object.keys(raw).sort();\nconst latest = dates[dates.length - 1];\nconst arr = Array.isArray(raw[latest]) ? raw[latest] : [];\n\nconst mostTraded = arr.map(o => ({\n  symbol: String(o.symbol || '').replace('.JK', ''),\n  volume: Number(o.volume) || 0\n})).filter(i => i.symbol);\n\nconst symbols = mostTraded.map(i => i.symbol);\nconst volumeMap = Object.fromEntries(mostTraded.map(i => [i.symbol, i.volume]));\n\nreturn {\n  mostTraded,\n  symbols,\n  volumeMap\n};"
      },
